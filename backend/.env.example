# Flask Environment Configuration
FLASK_ENV=development
SECRET_KEY=dev-secret-key-change-in-production-disaster-sys
PORT=5000

# Neon PostgreSQL Connection URL (SSL is required by Neon)
# Example Neon connection string:
# DATABASE_URL=postgresql://user:password@ep-xyz.us-east-2.aws.neon.tech/disaster_db?sslmode=require
DATABASE_URL=sqlite:///d:/micropred/disaster_dev.db

# CORS Allowed Origins (Comma-separated)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ML Artifact Paths
MODEL_PATH=artifacts/models/lstm_disaster_model.keras
PREPROCESSOR_PATH=artifacts/preprocessing/preprocessor.joblib
